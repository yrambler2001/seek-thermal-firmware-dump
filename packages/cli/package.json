{
  "name": "@seek-fw/cli",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "seek-fw": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "start": "npm run --silent build && node dist/bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@seek-fw/core": "2.0.0",
    "usb": "^3.1.0"
  }
}
